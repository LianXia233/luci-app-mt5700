{
	"luci-app-mt5700": {
		"description": "Grant UCI and ubus access for luci-app-at-webserver",
		"read": {
			"uci": [
				"at-webserver",
				"firewall"
			],
			"ubus": {
				"file": [
					"list",
					"read",
					"stat"
				],
				"luci": [
					"getInitList",
					"getRealtimeStats"
				],
				"service": [
					"list",
					"get_data"
				],
				"system": [
					"info"
				],
				"uci": [
					"get",
					"state",
					"configs"
				]
			},
			"file": {
				"/etc/config/at-webserver": [
					"read",
					"stat"
				],
				"/etc/config/firewall": [
					"read",
					"stat"
				],
				"/etc/init.d/at-webserver": [
					"list",
					"read",
					"stat"
				],
				"/tmp/at-notifications.log": [
					"read",
					"stat"
				],
				"/var/log/at-notifications.log": [
					"read",
					"stat"
				],
				"/tmp/*": [
					"list"
				],
				"/var/log/*": [
					"list"
				]
			}
		},
		"write": {
			"uci": [
				"at-webserver",
				"firewall"
			],
			"ubus": {
				"file": [
					"write",
					"read",
					"stat",
					"remove"
				],
				"luci": [
					"setInitAction"
				],
				"service": [
					"set",
					"delete",
					"update",
					"reload",
					"restart"
				],
				"uci": [
					"add",
					"set",
					"delete",
					"commit",
					"apply",
					"changes",
					"revert",
					"order"
				]
			},
			"file": {
				"/etc/config/at-webserver": [
					"write",
					"read",
					"stat"
				],
				"/etc/config/firewall": [
					"write",
					"read",
					"stat"
				],
				"/etc/init.d/at-webserver": [
					"exec"
				],
				"/tmp/at-notifications.log": [
					"write",
					"read",
					"stat"
				],
				"/var/log/at-notifications.log": [
					"write",
					"read",
					"stat"
				]
			}
		}
	}
}