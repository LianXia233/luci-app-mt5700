config at-webserver 'config'
	option enabled '1'
	option connection_type 'SERIAL'           # 默认 PCUI 优先：AT 走串口 /dev/ttyUSB1（PCUI）；网络 TCP 作为备用
	option network_host '192.168.8.1'
	option network_port '20249'
	option network_timeout '10'
	option network_allow_wan '0'          # 是否允许外网访问模块 (0=禁止, 1=允许)
	option network_restrict_access '0'    # 限制只有路由器本身可访问模块 (0=允许局域网, 1=仅路由器)
	# AT 命令走 PCUI 口，MT5700M-CN 上默认枚举为 ttyUSB1
	# （ttyUSB0=Application Interface, ttyUSB1=PCUI, ttyUSB2=SerialB, ttyUSB3=SerialC, ttyUSB4=GPS）
	# 填 'auto' 则逐个探测 /dev/ttyUSB* 自动选出能应答 AT 的端口
	option serial_port 'auto'          # 'auto' 逐个探测，优先 ttyUSB1(PCUI)
	option serial_port_custom '/dev/ttyUSB1'  # 自定义串口路径（当 serial_port='custom' 时使用）
	option serial_baudrate '115200'
	option serial_timeout '10'
	# 自动拨号：默认开启。模组不拨号则不会向 USB 网口下发 DHCP，
	# 网络接口 MT5700M 将一直拿不到 IP，表现为「模组在线但无法联网」。
	# 服务每次连上模组后会按此配置对齐一次（已在目标状态则不重复下发）。
	option autodial_enable '1'                 # 1=开启自动拨号（默认），0=关闭
	option autodial_mode '1'                   # 1=USB网络接口，2=转网口模式
	# 承载接口：auto=自动扫描（已有接口挂在模组网口上就用它，例如固件自带的 wan → usb0；
	#   没有则用 MT5700M），也可填接口名手动设置。IPv6 的 auto 跟随 IPv4 接口
	#   （用以 '@IPv4接口' 为设备的接口，没有则为 IPv4 接口名 + v6），none=不处理 IPv6。
	option iface_v4 'auto'
	option iface_v6 'auto'
	# 接口管理：1=承载接口缺失时创建、设为开机自启并登记到上行防火墙区域（默认）；
	# 0=不创建、不修改任何接口与防火墙，拨号就绪后只对选定的承载接口补一次 ifup。
	option manage_interface '1'
	option websocket_port '8765'           # LuCI RPC 监听端口
	option websocket_allow_wan '0'          # 1=RPC 监听 0.0.0.0 可被外部访问（建议同时设置 auth_key）
	option websocket_bind ''               # 可选：覆盖监听地址，如 0.0.0.0 或 192.168.10.1
	option websocket_auth_key ''            # RPC 访问密钥（留空则不验证；LuCI 登录态由 rpcd 会话保证）
	option cellscan_timeout '180'           # 一次 ^CELLSCAN 全网扫频允许运行的秒数（下限 10）

	# 通知配置
	option wechat_webhook ''
	# QQ 机器人推送（官方 API v2）。AppID + AppSecret + 目标 ID 全部填写后启用；
	# AppSecret 建议留空并改用环境变量 QQ_BOT_APP_SECRET（AppID 可用 QQ_BOT_APP_ID）注入，
	# 避免凭据落盘 UCI。推送为「主动消息」：群 30~60 条/分钟、单关系 20 条/分钟、1000 条/群/天。
	option qq_app_id ''
	option qq_app_secret ''
	option qq_target_type 'group'          # group=群聊 / c2c=单聊 / channel=频道 / bind=自动绑定
	option qq_target_id ''                 # group_openid / 用户 openid / channel_id（bind 模式由后端自动写回，勿手填）
	option qq_bind_qq ''                   # 绑定模式下你的 QQ 号（仅日志标签；绑定后给机器人发条消息即自动完成）
	option log_file '/tmp/at-notifications.log'
	# 通知日志文件的大小上限（字节，默认 256 KiB）。/tmp 是 tmpfs（占内存），
	# 不加限制时长期运行会把内存吃满；达到上限后按行边界裁掉最旧的一半再继续写。
	# 填小于 4096 的值会被忽略并回落默认。
	option log_file_max_bytes '262144'

	# 使用量「自动清零」日：每月几号（1~31，默认 1 号）。
	# 按自然月对账，不是滚动天数；大小月 / 闰年 / 跨年由后端处理，
	# 31 号这类小月没有的日子按当月最后一天触发（不会整月漏清）。
	option usage_reset_day '1'

	# 自动推送总开关。关闭后所有事件都不推送（仅写本地日志文件，便于事后追溯），
	# 同时停掉信号定时轮询（不再周期性占用串口）。默认开启。
	option notify_enabled '1'
	option notify_sms '1'
	option notify_call '1'
	option notify_memory_full '1'
	option notify_signal '1'

	# 定时推送间隔（分钟）：到点就推送一次「当前实际情况」（信号读数 + 短信存储占用），
	# 与期间有没有事件发生无关 —— 语义是「固定每 N 分钟必发一条」，不是「攒一起发」。
	# 范围 1-1440（1 分钟 ~ 24 小时），默认 10。调小更实时；调大更省推送配额
	# （QQ 机器人主动消息频控：单关系 20 条/分钟）。
	# 短信与来电不受此项影响，始终实时直发。
	option notify_timer_interval '10'

	# 定时轮询推送（信号巡检）。
	# 本模组不会主动上报 ^HCSQ / ^CERSSI，因此上面的 notify_signal 开关必须靠
	# 后端在下面这个时段内主动查询才会生效；时段外一条 AT 都不发，也不推送。
	# 时段写法：HH:MM，两端都算在时段内。起点大于终点即视为跨零点
	# （如 start=22:00 / end=06:00）；起止相同（如 00:00/00:00）或格式非法时按「全天」处理。
	option notify_poll_enabled '1'        # 是否启用信号定时巡检
	option notify_poll_start '00:00'      # 时段起点 HH:MM（含）
	option notify_poll_end '23:59'        # 时段终点 HH:MM（含，即默认全天）
	option notify_poll_interval '300'     # 轮询间隔（秒），范围 30-3600
	option notify_poll_all '0'            # 0=仅信号变化时推送 / 1=每次轮询都推送当前状态
	option notify_poll_delta '3'          # 变化阈值（dB），范围 1-30，仅 notify_poll_all=0 时生效

	# 自定义推送文案。留空 = 使用内置默认文案（升级后未被改动的项仍跟随版本更新）。
	# UCI 的 option 值是单行的，多行文案统一写成 \n 转义，LuCI 页面会自动转换；
	# 直接手改 UCI 时也按同样的转义写（后端按 \n / \t / \r / \\ 还原）。
	# 可用占位符：
	#   {sender}  发送者（短信为号码/名称）
	#   {content} 事件正文（短信内容、来电号码与状态、信号完整明细）
	#   {time}    事件时刻（本地时间 %Y-%m-%d %H:%M:%S）
	#   {kind}    事件类型中文名（新短信 / 来电 / 信号变化 / 存储空间已满）
	#   {count}   本条消息合并的事件条数（单条为 1）
	# 未识别的占位符原样保留。
	option notify_tpl_prefix ''             # 全局前缀，附加在所有推送消息最前面（测试通知也会带上）；支持 {time} {count}
	option notify_tpl_sms ''                # 例：'喵呜～，有新短信到啦！快来看看是谁给你发消息了喵~\n{sender}\n{content}\n({time})'
	option notify_tpl_call ''               # 例：'喵呜～有电话打进来啦，快接起来看看是谁找你喵！\n{content}'
	option notify_tpl_signal ''             # 例：'{content}'
	option notify_tpl_memory ''             # 例：'喵呜～短信存储空间已经满啦，请尽快清理一下喵，不然可能收不到新的短信了哦！'
	option notify_tpl_batch ''              # 批量汇总时的首行标题（例：'喵～有一批新通知需要查看哦，快来看看都有哪些消息吧！'）

	# 定时锁频配置
	option schedule_enabled '0'              # 启用定时锁频
	option schedule_check_interval '60'      # 检测间隔（秒）
	option schedule_timeout '180'            # 无服务超时时间（秒）
	option schedule_unlock_lte '1'           # 恢复时解锁LTE
	option schedule_unlock_nr '1'            # 恢复时解锁NR
	option schedule_toggle_airplane '1'      # 切换飞行模式生效

	# 定时任务配置
	option schedule_night_enabled '1'        # 启用夜间模式
	option schedule_night_start '22:00'      # 夜间模式开始时间
	option schedule_night_end '06:00'        # 夜间模式结束时间

	# 夜间模式 LTE 配置
	option schedule_night_lte_type '3'       # LTE锁定类型: 0=解锁, 1=频点, 2=小区, 3=频段
	option schedule_night_lte_bands ''       # LTE频段 (如: "3,8")
	option schedule_night_lte_arfcns ''      # LTE频点 (如: "1850,3450")
	option schedule_night_lte_pcis ''        # LTE PCI (如: "256,128")

	# 夜间模式 NR 配置
	option schedule_night_nr_type '3'        # NR锁定类型: 0=解锁, 1=频点, 2=小区, 3=频段
	option schedule_night_nr_bands ''        # NR频段 (如: "78,41")
	option schedule_night_nr_arfcns ''       # NR频点 (如: "630000,520000")
	option schedule_night_nr_scs_types ''    # NR SCS类型 (如: "1,1")
	option schedule_night_nr_pcis ''         # NR PCI (如: "100,200")

	option schedule_day_enabled '1'          # 启用日间模式

	# 日间模式 LTE 配置
	option schedule_day_lte_type '3'         # LTE锁定类型: 0=解锁, 1=频点, 2=小区, 3=频段
	option schedule_day_lte_bands ''         # LTE频段
	option schedule_day_lte_arfcns ''        # LTE频点
	option schedule_day_lte_pcis ''          # LTE PCI

	# 日间模式 NR 配置
	option schedule_day_nr_type '3'          # NR锁定类型: 0=解锁, 1=频点, 2=小区, 3=频段
	option schedule_day_nr_bands ''          # NR频段
	option schedule_day_nr_arfcns ''         # NR频点
	option schedule_day_nr_scs_types ''      # NR SCS类型
	option schedule_day_nr_pcis ''           # NR PCI
