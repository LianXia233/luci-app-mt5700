#!/bin/sh /etc/rc.common

START=99
STOP=10

# 手动维护入口（`/etc/init.d/at-webserver ensure_interfaces`）。
# 刻意只做「对齐」，不动后端进程：restart 会打断进行中的 AT 作业（eSIM 写卡、
# 短信、锁频）并清空内存环形日志，排查「有信号却上不了网」时不该付出这个代价。
EXTRA_COMMANDS="ensure_interfaces"
EXTRA_HELP="	ensure_interfaces	补建/补登记模组接口并尝试拉起（排查「有信号却上不了网」）"

USE_PROCD=1
PROG=/usr/bin/at-webserver-rust
PROG_NAME="at-webserver-rust"

# 本插件写进 /etc/config/firewall 的规则名。
#
# 启动与停止必须共用这一份清单：两者各写一份时，新增规则很容易只加在一边，
# 结果 stop 漏删 —— 服务已经停了，放行 8765 的规则却还留在防火墙里。
# 真机就出现过这种情况：服务停止后 at_rpc_wan_allow 仍在 nft 规则集里。
FW_RULE_NAMES="at_webserver_wan_block at_webserver_wan_allow at_module_restrict at_module_wan_block at_module_wan_allow at_rpc_wan_allow at_rpc_wan_block"

# 加载 UCI 函数库
. /lib/functions.sh

# 开机自启注册自愈。
#
# 症状：手动 `/etc/init.d/at-webserver start` 能起来，路由器重启后服务又不见了，
#       LuCI 提示「未注册 / 进程未运行」。
# 根因：/etc/rc.d/S99at-webserver 软链接不存在，也就是服务从来没 enable 成功过。
#       enable 只在安装那一刻执行一次（uci-defaults），那一次若因 init.d 丢执行位
#       而失败（真机 2026-09-15 故障，见 uci-defaults 注释），之后没人再补；
#       更麻烦的是 sysupgrade 保配置升级不会重跑 uci-defaults ——
#       故障会一直带到之后的每一次升级。
# 处理：每次 start 查一次，缺了就先补执行位再 enable。幂等，成本一次 test -e，
#       只要有人执行过一次 start（开机、点「重载服务」都算），注册就被永久修好。
#
# ★ 能力边界（别指望它救所有情况）：它只修得了「链接缺失」这一种。
#   如果 /etc/init.d/at-webserver 自己丢了执行位，`/etc/init.d/at-webserver start`
#   会直接被 shell 拒掉（ash: Permission denied，exit 126），**本函数根本没机会跑**
#   —— 要跑脚本才能自愈，而「跑不起来」正是问题本身（2026-09-22 实测确认）。
#   这条链只能靠另外三道防线：① git 里保持 100755；② Makefile 打包期 chmod 0755；
#   ③ uci-defaults 安装期 chmod 0755。真遇到时先手动
#   `chmod 0755 /etc/init.d/at-webserver`（断网排查页的 initd_exec 项也会给这条提示）。
#
# 调用时机：只在服务「判定为启用」之后调用（见 start_service），
# 用户明确禁用时不补链接 —— 否则界面显示「已启用」而服务起不来，自相矛盾。
ensure_enabled() {
	[ -e "/etc/rc.d/S${START}at-webserver" ] && return 0

	# 执行位可能在打包/刷机过程中再次丢失，先补权限再 enable
	[ -x /etc/init.d/at-webserver ] || chmod 0755 /etc/init.d/at-webserver 2>/dev/null
	/etc/init.d/at-webserver enable 2>/dev/null

	if [ -e "/etc/rc.d/S${START}at-webserver" ]; then
		logger -t at-webserver "检测到未注册开机自启，已自动补建 S${START}at-webserver"
	else
		logger -t at-webserver "警告：开机自启补建失败，重启后需手动 start"
	fi
	return 0
}

# 接口是否真的拿到了地址。
#
# 不能用 ifstatus 里的 "up": true 判断就绪 —— DHCP 请求进行中 up 就已经是 true，
# 于是会打出「已就绪（等待 0s 后拿到地址）」这种假成功日志，并提前放弃等待，
# 后面的补拉也就不会再走。判据必须是 ipv4/ipv6-address 数组里有元素
# （IPv6-only 也算就绪，两种只要有一种有地址即视为通）。
# 可靠写法是匹配数组括号后紧跟一个 '{'，而不是 grep 关键字本身 ——
# 空数组打印成 "ipv4-address": []，关键字照样命中。
iface_has_address() {
	ifstatus "$1" 2>/dev/null | tr -d '\n' \
		| grep -qE '"(ipv4-address|ipv6-address)"[[:space:]]*:[[:space:]]*\[[[:space:]]*\{'
}

start_service() {
	local enabled

	logger -t at-webserver "开始启动服务..."

	uci -q commit at-webserver

	config_load at-webserver
	config_get_bool enabled config enabled 0

	if [ "$enabled" -eq 0 ]; then
		logger -t at-webserver "服务已禁用，退出启动"
		echo "AT WebServer is disabled in configuration"
		return 1
	fi

	# ★ 开机自启自愈必须放在 enabled 检查**之后**。
	# 用户明确禁用（enabled=0）时绝不能补 S99 —— 补了会让 LuCI 的服务页和断网排查页
	# 都显示「已启用」（它们判的是 /etc/rc.d 链接存不存在），可开机时 start_service
	# 又会因 enabled=0 直接退出：界面说启用了、服务却起不来，两个结论互相矛盾，
	# 排查时最容易被带偏。（2026-09-22 实测复现：禁用状态下执行 start，
	# 日志先打「已自动补建 S99at-webserver」再打「服务已禁用，退出启动」。）
	# 用户之后若在 LuCI 里重新启用，rc.common 的 enable 会把链接建回来，不会丢。
	ensure_enabled

	if [ ! -x "$PROG" ]; then
		logger -t at-webserver "错误：找不到可执行文件 $PROG"
		echo "Error: $PROG not found"
		return 1
	fi

	# 先清残留进程，再立刻拉起 procd，避免防火墙/串口探测拖死 start。
	# 严重警告一：这里绝不能 `killall at-webserver`——init.d 被直接执行时（开机
	# /etc/rc.d/S*、`/etc/init.d/at-webserver start`、service 命令都是直接 exec 本脚本），
	# 脚本自身的进程名(comm)就是 "at-webserver"，killall 会把脚本自己一起 SIGTERM，
	# start 会在 procd_open_instance 之前被打断（exit 143），服务永远起不来。
	#
	# 严重警告二：也绝不能 `killall at-webserver-rust`——它是 procd 托管的进程，
	# 杀掉会被 procd 记成一次「崩溃」。respawn 的重试次数用尽后
	# （默认 retry=5 / threshold=3600，即一小时内 5 次）procd 会永久放弃重启，
	# 此时实例仍然注册在 procd 里但再也不会被拉起，表现为 LuCI 提示
	# 「实例已在 procd 注册但进程未运行，可能启动失败或被反复重启」。
	# 日志特征：procd: Instance at-webserver::instance1 in a crash loop ... crashes
	# 旧实例一律交给 procd 处理（见下方实例状态自愈）。
	killall -q at-server.py 2>/dev/null

	# ⚠ 这里**不能**写成「发现已在运行就 return」—— 2026-09-21 真机实测踩过这个坑。
	#
	# 原因在 rc.common：它对 procd 服务的 start 是
	#   rc_procd start_service → procd_open_service → `ubus call service set {... "instances": {} ...}`
	# 这个调用会把本服务的实例表**清空**，procd 随即对运行中的实例发 SIGTERM
	# （term_timeout 5s 到期再 SIGKILL）。也就是说：走到 start_service 这一刻，
	# 旧实例已经在被杀的路上了。此时若判定「已在运行 → 跳过」，
	# 结果就是旧实例被杀掉、又没有新实例注册，**服务直接消失**。
	# 实测日志特征（4 次复现，start 后 5~6 秒必现）：
	#   procd: Instance at-webserver::instance1 pid N not stopped on SIGTERM, sending SIGKILL instead
	# 结论：对 procd 托管的服务，`start` 天然等于「重新注册 + 重新启动」，
	# 不存在「幂等跳过」这条路。要只补接口、补防火墙区域而完全不碰后端进程，
	# 用 `ensure_interfaces` 子命令（走的是另一条路，不经过 rc.common 的 start）。
	#
	# 这里只保留一种自愈：实例已注册、进程却没在跑（procd 崩溃重试次数用尽后的
	# 「放弃态」）。此时必须先摘注册再重新登记，否则 start 只更新注册信息，
	# 进程永远不会被拉起。
	#
	# 另一条教训一并留档：ubus 判断**绝不能写成 `ubus -q call`** —— busybox 的 ubus
	# 没有 -q 选项（实测报 "unrecognized option: q"、退出码 1），那样写会让整个条件
	# 恒为假：既跳过不了重复启动，也让下面这段崩溃循环自愈**永远不执行**，服务一旦
	# 进入放弃态就只能靠手动 `ubus call service delete` 或整机重启救回来。
	if ubus call service list '{"name":"at-webserver"}' >/dev/null 2>&1 \
		&& ! ubus call service list '{"name":"at-webserver"}' 2>/dev/null \
			| grep -qE '"running"[[:space:]]*:[[:space:]]*true'; then
		logger -t at-webserver "发现已注册但未运行的 procd 实例（崩溃循环放弃态），先清除注册状态"
		ubus call service delete '{"name":"at-webserver"}' >/dev/null 2>&1 || true
		sleep 1
	fi

	# 这里刻意**不**「等旧实例退出」。
	# 试过：加一个 ps 轮询等旧进程消失再注册新实例，结果更糟 ——
	# procd 停止旧实例是异步的（实测从 service set 到进程真正消失约 15s，期间
	# procd 自己还在处理实例状态），轮询期间新实例被 procd 连带收走，
	# 等满上限后注册出来的实例反而活不下来，服务出现空窗。
	# 交给 procd 做它自己的新旧交替即可：我们只注册实例，procd 负责停旧起新。
	# 万一有短暂的串口争抢，后端本来就有 5s/10s/15s 退避重连，会自己接回来。

	logger -t at-webserver "配置 procd 实例..."

	# ---- 时区 ----
	# Rust 侧用 chrono::Local 取本地时间，而 chrono 判定本地时区只有三条路：
	#   1) TZ 环境变量
	#   2) 把 /etc/localtime 当 TZif 文件读
	#   3) iana-time-zone 拿到时区名，再去 /usr/share/zoneinfo 读同名文件
	# OpenWrt 上后两条经常是断的 —— 本固件的 /etc/localtime 指向并不存在的
	# /tmp/localtime，zoneinfo 目录也不存在，于是 chrono 静默回落 UTC：
	# 日志、短信时间、定时锁频会整整慢一个时区（实测 Rust 日志打
	# 2026-09-13 18:39:53，同一条记录 logd 打的是 Mon Sep 14 02:39:53）。
	# busybox 的 date 不受影响，是因为它读 OpenWrt 特有的 /etc/TZ。
	# 这里把同一个值注入给子进程，chrono 就能拿到正确偏移。
	#
	# 注意：拿不到值就必须干脆不注入，绝不能注入空串 —— chrono 把空的 TZ
	# 解释为 UTC，那比不设置更糟（不设置至少还会去试 /etc/localtime）。
	local sys_tz
	sys_tz=$(cat /etc/TZ 2>/dev/null | tr -d '[:space:]')
	[ -n "$sys_tz" ] || sys_tz=$(uci -q get system.@system[0].timezone)
	[ -n "$sys_tz" ] || sys_tz=$(uci -q get system.@system[0].zonename)

	procd_open_instance
	procd_set_param command "$PROG"
	if [ -n "$sys_tz" ]; then
		procd_set_param env TZ="$sys_tz"
		logger -t at-webserver "本地时区：TZ=$sys_tz"
	else
		logger -t at-webserver "警告：未能确定系统时区，日志与定时功能将按 UTC 计"
	fi
	procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param pidfile /var/run/at-webserver-rust.pid
	procd_close_instance

	logger -t at-webserver "服务启动配置完成"
	echo "AT WebServer started successfully"

	# 串口探测与防火墙放到后台，避免 /etc/init.d/firewall reload 阻塞 start
	( at_webserver_post_start ) >/dev/null 2>&1 &
}

at_webserver_post_start() {
	config_load at-webserver

	# 音频驱动：仅当模组暴露出 USB Audio Class 接口时才装载随包的 ALSA
	# 依赖链（11 个 .ko，顺序敏感，见 root/usr/share/mt5700/audio-ko.sh）。
	# 当前 MT5700M-CN 没有 Audio Class，这里会立刻返回、一个模块都不装 ——
	# 它在等的是「换成带 UAC 的模组」那个场景。
	# 放在后台段里是因为 insmod 虽然只要几百毫秒，也没有理由挡着 start 返回；
	# usb hotplug 已有同源入口，这里只兜住「开机时设备早已在、hotplug 未触发」。
	/usr/share/mt5700/audio-ko.sh load >/dev/null 2>&1 || true

	# 网络接口 MT5700M 的启动对齐（见下方 ensure_modem_interface 注释）
	ensure_modem_interface

	# 串口模式下尝试绑定 MT5700 USB 串口
	local conn_type
	config_get conn_type config connection_type 'SERIAL'
	if [ "$conn_type" = "SERIAL" ] && ! ls /dev/ttyUSB* >/dev/null 2>&1; then
		if command -v lsusb >/dev/null 2>&1 && lsusb -d 3466:3301 >/dev/null 2>&1; then
			modprobe usbserial 2>/dev/null || true
			modprobe option 2>/dev/null || true
			local drv new_id
			for drv in option option1 generic; do
				new_id="/sys/bus/usb-serial/drivers/$drv/new_id"
				[ -w "$new_id" ] || continue
				echo "3466 3301" > "$new_id" 2>/dev/null || continue
				sleep 1
				ls /dev/ttyUSB* >/dev/null 2>&1 && {
					logger -t at-webserver "已通过 $drv 绑定 3466:3301"
					break
				}
			done
		fi
	fi

	# 防火墙规则（RPC + 模块 AT 端口）
	local module_allow_wan restrict_module module_host module_port
	local rpc_allow_wan rpc_port
	config_get_bool module_allow_wan config network_allow_wan 0
	config_get_bool restrict_module config network_restrict_access 0
	config_get module_host config network_host '192.168.8.1'
	config_get module_port config network_port '20249'
	config_get_bool rpc_allow_wan config websocket_allow_wan 0
	config_get rpc_port config websocket_port 8765

	local rule_name rule_idx
	for rule_name in $FW_RULE_NAMES; do
		rule_idx=$(uci show firewall 2>/dev/null | grep "\.name='$rule_name'" | cut -d'[' -f2 | cut -d']' -f1 | head -n1)
		[ -n "$rule_idx" ] && uci delete firewall.@rule[$rule_idx] 2>/dev/null
	done
	uci commit firewall 2>/dev/null

	# RPC 对外监听时放行端口；否则保持无 WAN 规则（仅回环）
	if [ "$rpc_allow_wan" -eq 1 ]; then
		uci add firewall rule >/dev/null
		uci set firewall.@rule[-1].name='at_rpc_wan_allow'
		uci set firewall.@rule[-1].src='lan'
		uci set firewall.@rule[-1].dest='*'
		uci set firewall.@rule[-1].dest_port="$rpc_port"
		uci set firewall.@rule[-1].proto='tcp'
		uci set firewall.@rule[-1].target='ACCEPT'
		uci set firewall.@rule[-1].enabled='1'
		logger -t at-webserver "已允许访问 RPC 端口 $rpc_port（建议设置 auth_key）"
	fi

	if [ "$module_allow_wan" -eq 1 ]; then
		uci add firewall rule >/dev/null
		uci set firewall.@rule[-1].name='at_module_wan_allow'
		uci set firewall.@rule[-1].src='wan'
		uci set firewall.@rule[-1].dest='*'
		uci set firewall.@rule[-1].dest_ip="$module_host"
		uci set firewall.@rule[-1].dest_port="$module_port"
		uci set firewall.@rule[-1].proto='tcp'
		uci set firewall.@rule[-1].target='ACCEPT'
		uci set firewall.@rule[-1].enabled='1'
	else
		uci add firewall rule >/dev/null
		uci set firewall.@rule[-1].name='at_module_wan_block'
		uci set firewall.@rule[-1].src='wan'
		uci set firewall.@rule[-1].dest='*'
		uci set firewall.@rule[-1].dest_ip="$module_host"
		uci set firewall.@rule[-1].dest_port="$module_port"
		uci set firewall.@rule[-1].proto='tcp'
		uci set firewall.@rule[-1].target='REJECT'
		uci set firewall.@rule[-1].enabled='1'
	fi

	if [ "$restrict_module" -eq 1 ]; then
		uci add firewall rule >/dev/null
		uci set firewall.@rule[-1].name='at_module_restrict'
		uci set firewall.@rule[-1].src='lan'
		uci set firewall.@rule[-1].dest='*'
		uci set firewall.@rule[-1].dest_ip="$module_host"
		uci set firewall.@rule[-1].dest_port="$module_port"
		uci set firewall.@rule[-1].proto='tcp'
		uci set firewall.@rule[-1].target='REJECT'
		uci set firewall.@rule[-1].enabled='1'
	fi

	uci commit firewall 2>/dev/null
	# 后台 reload，避免阻塞；失败不致命
	timeout 8 /etc/init.d/firewall reload >/dev/null 2>&1 || true
	logger -t at-webserver "后台防火墙/串口初始化完成"
}

# 把接口加进防火墙 wan 区（幂等）。
#
# 症状：接口建好了、也拿到 IP 了，路由器自己能上网，但手机电脑全断。
# 原因是 wan 区的 network 列表里没有这个接口，nft 的 srcnat 链只匹配 eth1，
# 5G 出口的流量不做 NAT —— 出去就回不来。
# 处理：找到 name='wan' 的 zone，列表里没有该接口就 add_list 进去并重载防火墙。
ensure_wan_zone() {
	local iface="$1"
	local idx list

	idx=$(uci show firewall 2>/dev/null | grep -E "@zone\[[0-9]+\]\.name='wan'$" \
		| head -n1 | sed "s/.*@zone\[\([0-9]*\)\].*/\1/")
	[ -n "$idx" ] || {
		logger -t at-webserver "警告：未找到防火墙 wan 区，$iface 不会做 NAT"
		return 0
	}

	list=$(uci -q get "firewall.@zone[$idx].network")
	case " $list " in
		*" $iface "*) return 0 ;;
	esac

	uci -q add_list "firewall.@zone[$idx].network=$iface"
	uci -q commit firewall
	logger -t at-webserver "已将 $iface 加入防火墙 wan 区（否则出口流量不做 NAT）"
	# 后台 reload，避免阻塞；失败不致命
	timeout 10 /etc/init.d/firewall reload >/dev/null 2>&1 || true
}

# 确保 MT5700M / MT5700Mv6 接口处于「开机自启」状态并在等待模组网口就绪后拉起。
#
# 症状（问题二）：LuCI 上模组显示在线，但「网络 → 接口」里 MT5700M 没有 IP，
# 因此上不了网。取证结果：
#   ifstatus MT5700M → "up": false, "autostart": false
# UCI 里该接口只有 device/ifname/proto/metric/defaultroute/norelease，
# 既没有 auto='1'，也没人主动 ifup，于是 netifd 从不启动它 ——
# 即使模组拨号成功、eth2 已经能 DHCP，接口也不会去要地址。
#
# 处理策略（幂等，可重复执行）：
#   1) 打开 auto='1'（开机自启），让 ifup 在模组网口就绪后自然生效；
#   2) 若接口尚未 up，调用 `ifup` 主动拉起一次；
#   3) 等待 dhcp 客户端拿到地址（最多 ~20s），拿到即结束，避免无谓等待。
# 注意：不写入 IP/网关等具体地址，全部交给 dhcp proto 协商，
# 也不改动 eth2 的设备名与 metric，保持机型定制包的定义。
ensure_modem_interface() {
	local ifname_4g='MT5700M'
	local ifname_6g='MT5700Mv6'
	local i auto_val need_commit=0

	# 设备名从 UCI 取，不写死 eth2：驱动/固件不同的机器上它可能叫别的名字。
	# device 允许是多值，只取第一个。取不到再回退 eth2，老行为不变。
	local modem_dev
	modem_dev=$(uci -q get "network.$ifname_4g.device" 2>/dev/null)
	[ -n "$modem_dev" ] || modem_dev=$(uci -q get "network.$ifname_4g.ifname" 2>/dev/null)
	[ -n "$modem_dev" ] || modem_dev='eth2'
	modem_dev=${modem_dev%% *}

	# ① 接口压根不存在时，按「模组网口 + DHCP」创建
	#
	# 症状：刷完新固件直接没网。取证见 /etc/config/network 里没有 MT5700M ——
	# netifd 不认识 eth2 → 没人把它 up → cdc_ncm 拿不到 carrier → 没人发 DHCP →
	# 路由表里一条 default 都没有。而模组侧完全正常（PDP 已激活、NCM 已连接），
	# 看门狗与 hotplug 日志里那句「已重启 MT5700M」其实每次都是对空气挥拳。
	# 机型定制包没带上这条接口时，这里兜底建出来。
	if ! uci -q get "network.$ifname_4g" >/dev/null 2>&1; then
		local waited=0
		while [ "$waited" -lt 15 ]; do
			[ -e "/sys/class/net/$modem_dev" ] && break
			sleep 1
			waited=$((waited + 1))
		done

		if [ ! -e "/sys/class/net/$modem_dev" ]; then
			logger -t at-webserver "警告：未发现模组网口 $modem_dev，跳过自动创建 $ifname_4g"
			return 0
		fi

		uci -q set "network.$ifname_4g=interface"
		uci -q set "network.$ifname_4g.device=$modem_dev"
		uci -q set "network.$ifname_4g.proto=dhcp"
		uci -q set "network.$ifname_4g.auto=1"
		uci -q set "network.$ifname_4g.defaultroute=1"
		uci -q set "network.$ifname_4g.peerdns=1"
		uci -q set "network.$ifname_4g.metric=20"
		need_commit=1
		logger -t at-webserver "配置缺少 $ifname_4g，已自动创建（$modem_dev + dhcp, metric 20）"
		ensure_wan_zone "$ifname_4g"
	fi

	for i in "$ifname_4g" "$ifname_6g"; do
		# 接口不存在则跳过（6G 接口不由本插件凭空创建）
		if ! uci -q get "network.$i" >/dev/null 2>&1; then
			continue
		fi
		auto_val=$(uci -q get "network.$i.auto")
		if [ "$auto_val" != "1" ]; then
			uci -q set "network.$i.auto=1"
			need_commit=1
		fi

		# 每次启动都核对一次 wan 区登记。原来只在「接口不存在→新建」那条路径登记，
		# 于是「接口早就建好了、只是没进 wan 区」这种情况永远补不上 ——
		# 那正是「有 IP、有信号，但内网全断」最常见的成因：
		# srcnat 链只匹配在 wan 区里的接口，漏登记的包出去就回不来。
		# ensure_wan_zone 本身幂等，列表里已有就什么都不做、也不会重载防火墙。
		ensure_wan_zone "$i"
	done

	[ "$need_commit" -eq 1 ] && {
		uci -q commit network
		logger -t at-webserver "已将 $ifname_4g/$ifname_6g 设置为开机自启（auto=1）"
	}

	# 已经拿到地址就不用再动（判据为什么不能用 "up": true，见 iface_has_address）
	if iface_has_address "$ifname_4g"; then
		return 0
	fi

	# 模组网口可能还没枚举完成，先等设备出现（最多 15s）
	#（设备名已在函数开头算好，这里不再重复取）
	local waited=0
	while [ "$waited" -lt 15 ]; do
		[ -e "/sys/class/net/$modem_dev" ] && break
		sleep 1
		waited=$((waited + 1))
	done

	# 冷启动链路实测要 30~60s：模组自动拨号 → NCM 建链 → 网口 carrier → DHCP。
	# 只 ifup 一轮覆盖不全，这里带间隔重试；本函数跑在 post_start 的后台，
	# 不会把 start 拖住（最坏 6×10s＝60s，接口 up 后每轮还会提前返回）。
	#
	# 只在接口 netifd 侧尚未 up 时才 ifup：已经 up 只是 DHCP 没回来时反复 ifup，
	# 每次都把进行中的 DHCP 打回起点，反而更慢。
	local retry=0
	while [ "$retry" -lt 6 ]; do
		if ! ifstatus "$ifname_4g" 2>/dev/null | grep -q '"up": true'; then
			ifup "$ifname_4g" >/dev/null 2>&1 || true
			ifup "$ifname_6g" >/dev/null 2>&1 || true
		fi

		waited=0
		while [ "$waited" -lt 10 ]; do
			if iface_has_address "$ifname_4g"; then
				logger -t at-webserver "$ifname_4g 已拿到地址（第 $((retry + 1)) 轮 ifup，等待 ${waited}s）"
				return 0
			fi
			sleep 2
			waited=$((waited + 2))
		done
		retry=$((retry + 1))
	done

	logger -t at-webserver "警告：$ifname_4g 仍未拿到地址，模组网口或自动拨号可能未就绪（详见 logread -e at-webserver）"
	return 0
}

stop_service() {
	logger -t at-webserver "停止服务..."
	echo "Stopping AT WebServer..."

	# 不在此 killall：进程由 procd 托管，stop 时 procd 已按 term_timeout 发送终止信号；
	# 额外 killall 会被记成一次「崩溃」，反复 stop/start 会攒满 respawn 重试次数，
	# 最终让 procd 永久放弃重启（见 start_service 的「严重警告二」）。
	rm -f /var/run/at-webserver-rust.pid

	# 清理防火墙规则（幂等）。清单与启动时共用 FW_RULE_NAMES，避免漏删。
	for rule_name in $FW_RULE_NAMES; do
		local rule_idx=$(uci show firewall 2>/dev/null | grep "\.name='$rule_name'" | cut -d'[' -f2 | cut -d']' -f1 | head -n1)
		if [ -n "$rule_idx" ]; then
			uci delete firewall.@rule[$rule_idx] 2>/dev/null
		fi
	done
	uci commit firewall 2>/dev/null
	timeout 8 /etc/init.d/firewall reload >/dev/null 2>&1 || true
	logger -t at-webserver "已清理所有防火墙规则"

	sleep 1
	logger -t at-webserver "服务已停止"
	echo "AT WebServer stopped"
}

reload_service() {
	logger -t at-webserver "重新加载配置..."
	echo "Reloading AT WebServer configuration..."

	uci -q commit at-webserver

	# 直接走 rc.common 的标准 start 路径（procd_open_service → start_service）。
	#
	# 为什么不能自己 `ubus call service delete` 去停旧实例：那个调用删掉的是
	# **整个服务对象**，紧接着 start_service 里的 procd_open_instance 就变成
	# 往一个正在被删除的对象上注册实例，procd 收尾时会把新实例一并清掉 ——
	# 2026-09-21 实测：reload 返回 0、日志打满「配置重新加载完成」，
	# 但进程列表里一个后端都没有（连一条 Rust 启动日志都没打出来）。
	#
	# 标准 start 的顺序正好是我们需要的：先 procd_open_service 重新声明服务
	# （实例表置空，旧实例随之被 procd 正常停止并回收串口），
	# 再由 start_service 注册并拉起新实例；服务对象与实例都是完整的。
	start "$@"

	logger -t at-webserver "配置重新加载完成"
}

# 手动自愈入口：/etc/init.d/at-webserver ensure_interfaces
#
# 用途：排查「模组在线、LuCI 有信号，但接口没 IP 或内网全断」时，只补接口、
#       补 wan 区登记、补一次拉起，**完全不碰后端进程**。restart 代价比这大得多：
#       打断进行中的 AT 作业（eSIM 写卡、短信、锁频）、清空内存环形日志，
#       还会在排查过程中把现场冲掉。
# 走的仍是 ensure_modem_interface 这一份逻辑，与开机/启动时完全同源，幂等可重复。
ensure_interfaces() {
	logger -t at-webserver "手动执行 ensure_interfaces：对齐模组接口与防火墙 wan 区"
	ensure_modem_interface
	logger -t at-webserver "ensure_interfaces 执行完毕"
	return 0
}

service_triggers() {
	procd_add_reload_trigger "at-webserver"
}
