#!/bin/sh /etc/rc.common

START=99
STOP=10

USE_PROCD=1

# 自定义动作：登记到帮助里，用户不必知道内部函数名也能发现这两个入口。
#   ensure_interfaces  确保 V4/V6 模组接口存在（安装/升级后 postinst 也会调用）
#   on_uplink          拉起模组接口（后端确认拨号就绪时调用）
EXTRA_COMMANDS="ensure_interfaces on_uplink"
EXTRA_HELP="	ensure_interfaces	确保 V4/V6 模组接口存在（安装/升级后自动调用）
	on_uplink		拉起模组接口（后端确认拨号就绪时调用）"

PROG=/usr/bin/at-webserver-rust
PROG_NAME="at-webserver-rust"

# 加载 UCI 函数库
. /lib/functions.sh

# 模组接口名（与机型定制包保持一致）
IFACE_4G='MT5700M'
IFACE_6G='MT5700Mv6'

# 拉起接口的重试预算。
#
# 背景：模组冷启动链路是「USB 枚举 → AT 就绪 → 驻网 → 开启自动拨号 → 向 USB 网口
# 下发 DHCP → netifd 取址」，整条链常见耗时 30~60s。旧实现是「等设备 15s +
# ifup 一次 + 等 up 20s」，共 35s 后只打一条警告就永久放弃，之后没有任何机制补
# ifup（仓库里也没有 hotplug 脚本），于是接口长期没有 IP——模组明明在线。
# 现在改为带间隔的多次 ifup，覆盖整条冷启动链路。
IFUP_RETRY_TIMES=18
IFUP_RETRY_INTERVAL=10

# 开机自启注册自愈。
#
# 现象：手动 /etc/init.d/at-webserver start 能起来，但路由器重启后服务又消失，
#       LuCI 显示「未注册 / 进程未运行 / procd 无实例」。
# 根因：/etc/rc.d/S${START}at-webserver 软链接缺失，即服务从未被 enable。
#       （历史上是 init.d 执行位回退导致安装期 enable 失败，详见 uci-defaults 注释。
#         enable 只在安装那一刻执行一次，错过之后不会自动补。）
# 处理：每次 start 都检查一次，缺失就补 enable。这样即便存量设备错过了
#       安装期注册，只要有人（或开机、或点一下「重载服务」）执行一次 start，
#       注册状态就被永久修好，不会再随重启复发。幂等，可重复执行。
ensure_enabled() {
	[ -e "/etc/rc.d/S${START}at-webserver" ] && return 0

	# 执行位可能在打包/刷机过程中再次丢失，先补权限再 enable
	[ -x "/etc/init.d/at-webserver" ] || chmod 0755 /etc/init.d/at-webserver 2>/dev/null
	/etc/init.d/at-webserver enable 2>/dev/null

	if [ -e "/etc/rc.d/S${START}at-webserver" ]; then
		logger -t at-webserver "检测到服务未注册开机自启，已自动补建 S${START}at-webserver"
	else
		logger -t at-webserver "警告：服务未注册开机自启且自动 enable 失败，重启后需手动 start"
	fi
	return 0
}

start_service() {
	local enabled

	logger -t at-webserver "开始启动服务..."

	ensure_enabled

	uci -q commit at-webserver

	config_load at-webserver
	config_get_bool enabled config enabled 0

	if [ "$enabled" -eq 0 ]; then
		logger -t at-webserver "服务已禁用，退出启动"
		echo "AT WebServer is disabled in configuration"
		return 1
	fi

	if [ ! -x "$PROG" ]; then
		logger -t at-webserver "错误：找不到可执行文件 $PROG"
		echo "Error: $PROG not found"
		return 1
	fi

	# 先清残留进程，再立刻拉起 procd，避免防火墙/串口探测拖死 start。
	# 严重警告：这里绝不能 `killall at-webserver`——init.d 被直接执行时（开机
	# /etc/rc.d/S*、`/etc/init.d/at-webserver start`、service 命令都是直接 exec 本脚本），
	# 脚本自身的进程名(comm)就是 "at-webserver"，killall 会把脚本自己一起 SIGTERM，
	# start 会在 procd_open_instance 之前被打断（exit 143），服务永远起不来。
	# 旧实例交给 procd 处理（reload_service 已这么做），这里只清遗留二进制。
	killall -q at-server.py 2>/dev/null
	killall -q "$PROG_NAME" 2>/dev/null

	logger -t at-webserver "配置 procd 实例..."
	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param pidfile /var/run/at-webserver-rust.pid
	procd_close_instance

	logger -t at-webserver "服务启动配置完成"
	echo "AT WebServer started successfully"

	# 串口绑定、接口拉起与防火墙放到后台，避免 /etc/init.d/firewall reload 阻塞 start
	( at_webserver_post_start ) >/dev/null 2>&1 &
}

at_webserver_post_start() {
	config_load at-webserver

	# 1) 串口模式：先确保 MT5700 的 USB 串口被绑定出来（后端要靠它发 AT）
	local conn_type
	config_get conn_type config connection_type 'SERIAL'
	# 注意：`ls /dev/ttyUSB* /dev/ttyACM*` 在其中一个通配符**无匹配**时也会返回非 0
	# （ls 会对不存在的参数报错），于是「串口早已就绪」会被误判成「没有串口」，
	# 每次启动都白跑一遍绑定流程。两个通配符必须分开判定。
	if [ "$conn_type" = "SERIAL" ] \
		&& ! ls /dev/ttyUSB* >/dev/null 2>&1 \
		&& ! ls /dev/ttyACM* >/dev/null 2>&1; then
		bind_modem_serial
	fi

	# 2) 模组接口的启动对齐（见下方 ensure_modem_interface 注释）
	ensure_modem_interface

	# 3) 防火墙规则（RPC + 模块 AT 端口）
	apply_firewall_rules

	logger -t at-webserver "后台串口/接口/防火墙初始化完成"
}

# ---------------------------------------------------------------------------
# 串口绑定：把 MT5700 的 USB 串口挂到 usb-serial 驱动上。
#
# 旧实现依赖 lsusb 且把 VID:PID 写死为 3466:3301，两个问题：
#   1) lsusb 属于 usbutils，而本包刻意不在 LUCI_DEPENDS 声明它（避免拖 libusb），
#      未装 usbutils 的固件上 command -v lsusb 为假 → 整段静默跳过，日志里
#      看不出任何原因，现象是「没有任何 ttyUSB 设备、后端反复报找不到串口」。
#   2) PID 会随 AT^SETMODE 切换 USB 组合而变化，写死 PID 在切换后必然失效。
# 现在直接读 sysfs（不需要任何外部工具），按 VID 匹配、PID 透传。
# ---------------------------------------------------------------------------
bind_modem_serial() {
	local dev vid pid drv new_id

	for dev in /sys/bus/usb/devices/*/idVendor; do
		[ -f "$dev" ] || continue
		vid=$(cat "$dev" 2>/dev/null)
		pid=$(cat "$(dirname "$dev")/idProduct" 2>/dev/null)
		[ -n "$vid" ] && [ -n "$pid" ] || continue
		# 3466 为 MT5700 的 vendor id；只固定 VID，PID 随 USB 模式变化
		[ "$vid" = "3466" ] || continue

		logger -t at-webserver "检测到模组 USB 设备 $vid:$pid，尝试绑定串口驱动"
		modprobe usbserial 2>/dev/null || true
		modprobe option 2>/dev/null || true

		for drv in option option1 generic; do
			new_id="/sys/bus/usb-serial/drivers/$drv/new_id"
			[ -w "$new_id" ] || continue
			echo "$vid $pid" > "$new_id" 2>/dev/null || continue
			sleep 1
			if ls /dev/ttyUSB* >/dev/null 2>&1 || ls /dev/ttyACM* >/dev/null 2>&1; then
				logger -t at-webserver "已通过 $drv 绑定 $vid:$pid"
				return 0
			fi
			logger -t at-webserver "通过 $drv 绑定 $vid:$pid 后仍未出现串口节点，继续尝试"
		done
	done

	logger -t at-webserver "未发现可绑定的 MT5700 USB 设备（3466:*），或串口已由内核自动绑定"
	return 1
}

# ---------------------------------------------------------------------------
# 模组网口的设备名（统一来源，避免各处硬编码 eth2）
#
# 优先取 UCI network.<iface>.device，其次兼容旧的 ifname；
# 都拿不到时在 /sys/class/net 里探测挂在 USB 总线上的网卡
# （cdc_ncm / cdc_ether / rndis_host / cdc_mbim 都会出现在 usb 设备路径下）。
# 硬编码 eth2 在不同机型上可能不成立；仓库里 ucode 侧早就改成「不硬编码」，
# 这里统一到同一套规则。
# ---------------------------------------------------------------------------
detect_usb_netdev() {
	local d link
	for d in /sys/class/net/*; do
		[ -e "$d" ] || continue
		case "$(basename "$d")" in
			lo|br-*|eth0|eth1) continue ;;
		esac
		link=$(readlink -f "$d/device" 2>/dev/null)
		case "$link" in
			*usb*) echo "$(basename "$d")"; return 0 ;;
		esac
	done
	return 1
}

iface_device_name() {
	local iface dev
	iface="$1"
	dev=$(uci -q get "network.$iface.device")
	[ -n "$dev" ] || dev=$(uci -q get "network.$iface.ifname")
	[ -n "$dev" ] || dev=$(detect_usb_netdev 2>/dev/null)
	echo "$dev"
}

# 接口是否已经拿到地址。
# 不能用 ifstatus 的 "up": true 当作「已拿到地址」：dhcp 在请求中或失败重试时
# 接口同样是 up，此时日志却会写「已就绪（已拿到地址）」，把排障方向带偏。
# 判据：ifstatus 的 ipv4-address / ipv6-address 数组里确实有元素。
#
# 踩坑记录：ifstatus 输出是**美化过的多行 JSON**，`"ipv4-address": [` 之后就是换行。
# 若正则写成 `\[[^]]`（要求 `[` 后同行还有非 ] 字符），则永远匹配不到 ——
# 实测该 bug 会让「接口明明有 IP」也被判成没有地址，于是走满 180s 重试并打出
# 「未取到地址」的误报，同时拖住安装流程。必须先 tr 掉换行再匹配。
iface_has_address() {
	ifstatus "$1" 2>/dev/null | tr -d '\n' \
		| grep -qE '"(ipv4-address|ipv6-address)"[[:space:]]*:[[:space:]]*\[[[:space:]]*\{'
}

# ---------------------------------------------------------------------------
# 机型未预置接口时自动创建（V4 与 V6 都要创建）
#
# 旧行为是「接口不存在则 continue」——在非定制机型上等于什么都不做，也没有任何日志。
# 用户看到的是「模组 AT 在线、接口列表里没有 MT5700M、无法联网」，且完全不知道插件跳过了。
#
# 核心原则：**接口先建好，地址再谈**。
#   地址能不能拿到取决于运营商与模组状态（尤其 IPv6），但接口本身不应该因为
#   「此刻还没拿到地址」或「缺少某个客户端」就不存在 —— 那会让模组在线却没有接口可管。
#
# 取址策略按可用性分档：
#   V4（MT5700M，proto=dhcp）：**必须拿到地址**，拿不到等于没网，由带间隔的重试循环
#       + hotplug(iface/usb) + 后端 on-uplink 通知三路兜底；
#   V6（MT5700Mv6，proto=dhcpv6）：**按实际网络状况获取** —— 运营商下发就取到，
#       不下发也不影响 IPv4 使用，所以用 reqaddress=try / reqprefix=auto 不做强制。
#
# 因此以下情况都不会阻止创建（只记录提示）：
#   - 缺少 odhcp6c：V6 接口照建，安装 odhcp6c 后即生效；
#   - 模组网口尚未枚举：接口照建，之后由 on_uplink / hotplug 补齐 device。
#
# 两者共用模组的同一 USB 网口（OpenWrt 默认配置里的 wan / wan6 也是这么写的，
# netifd 允许同一 device 被 v4 与 v6 两个 interface 同时使用）。
#
# 参数：$1=接口名  $2=proto（dhcp / dhcpv6）
# ---------------------------------------------------------------------------
ensure_iface_created() {
	local iface proto device cur_dev cur_proto

	iface="$1"
	proto="$2"

	# V4 的设备名按 sysfs 探测模组 USB 网口（V6 不直接用设备名，见下）
	device=$(uci -q get "network.${IFACE_4G}.device")
	[ -n "$device" ] || device=$(iface_device_name "$IFACE_4G")

	if uci -q get "network.$iface" >/dev/null 2>&1; then
		# 已存在：只在缺 device 时补齐，不改动其它配置
		cur_dev=$(uci -q get "network.$iface.device")
		if [ -z "$cur_dev" ]; then
			if [ "$proto" = "dhcpv6" ]; then
				uci -q set "network.$iface.device=@${IFACE_4G}"
				uci -q set "network.$iface.ifname=@${IFACE_4G}"
				uci -q commit network
				logger -t at-webserver "$iface 已补上 device=@${IFACE_4G}"
			elif [ -n "$device" ]; then
				uci -q set "network.$iface.device=$device"
				uci -q commit network
				logger -t at-webserver "$iface 已补上 device=$device"
			fi
		fi
		return 0
	fi

	logger -t at-webserver "机型未预置 $iface 接口，自动创建（proto=$proto）"
	uci -q set "network.$iface=interface"
	uci -q set "network.$iface.proto=$proto"

	if [ "$proto" = "dhcpv6" ]; then
		# 用 @<V4 接口> 引用上层设备，与机型定制包写法一致
		# （实测 H5000M 上 MT5700Mv6 的 device/ifname 就是 '@MT5700M'）。
		# 好处：V4 若换了网口名（eth2 → 其它），V6 自动跟随，不需要两处同步。
		uci -q set "network.$iface.device=@${IFACE_4G}"
		uci -q set "network.$iface.ifname=@${IFACE_4G}"
		# 按实际网络状况获取：运营商下发就取到，不下发也不判失败
		uci -q set "network.$iface.reqaddress=try"
		uci -q set "network.$iface.reqprefix=auto"
		# 允许把上游前缀扩展分发给下游接口（LAN）——不加这一项，
		# 即使拿到 IPv6 前缀也不会下发到内网，等于白拿。
		uci -q set "network.$iface.extendprefix=1"
		uci -q set "network.$iface.defaultroute=1"
	else
		[ -n "$device" ] && uci -q set "network.$iface.device=$device"
	fi

	uci -q set "network.$iface.auto=1"
	uci -q commit network

	# 创建后的提示（不影响接口存在）
	if [ "$proto" = "dhcpv6" ] && ! command -v odhcp6c >/dev/null 2>&1; then
		logger -t at-webserver "提示：$iface 已创建，但系统缺少 odhcp6c，暂时无法获取 IPv6 地址（安装 odhcp6c 后生效）"
	fi
	if [ "$proto" != "dhcpv6" ] && [ -z "$device" ]; then
		logger -t at-webserver "提示：$iface 已创建，但暂未确定模组网口，网口枚举后会自动补上 device"
	fi

	cur_proto=$(uci -q get "network.$iface.proto")
	[ "$cur_proto" = "$proto" ] || logger -t at-webserver "警告：$iface 自动创建后 proto=$cur_proto，非预期（期望 $proto）"
	return 0
}

# ---------------------------------------------------------------------------
# 模组接口的启动对齐（幂等，可重复执行）
#
# 症状：LuCI 上模组显示在线，但「网络 → 接口」里 MT5700M 没有 IP，因此上不了网。
# 取证结果：ifstatus MT5700M → "up": false, "autostart": false。
# UCI 里该接口只有 device/ifname/proto/metric/defaultroute/norelease，
# 既没有 auto='1'，也没人主动 ifup，于是 netifd 从不启动它 ——
# 即使模组拨号成功、USB 网口已经能 DHCP，接口也不会去要地址。
#
# 处理策略：
#   1) 接口不存在且能定位到模组 USB 网口 → 自动创建；
#   2) 打开 auto='1'（开机自启）；
#   3) 校验 proto（机型把接口定成 none/static 时开自动拨号也拿不到地址，需明确告警）；
#   4) 以「已取到地址」为达成条件，带间隔多次 ifup（覆盖 30~60s 的冷启动链路）。
# 注意：不写入 IP/网关等具体地址，全部交给 dhcp proto 协商，
# 也不改动设备名与 metric，保持机型定制包的定义。
# ---------------------------------------------------------------------------
ensure_modem_interface() {
	local i iface_4g iface_6g auto_val need_commit=0 p n

	iface_4g="$IFACE_4G"
	iface_6g="$IFACE_6G"

	# V4 与 V6 都自动创建：V4 必须拿到地址，V6 按实际网络状况获取
	ensure_iface_created "$iface_4g" dhcp || true
	ensure_iface_created "$iface_6g" dhcpv6 || true

	for i in "$iface_4g" "$iface_6g"; do
		uci -q get "network.$i" >/dev/null 2>&1 || continue
		auto_val=$(uci -q get "network.$i.auto")
		if [ "$auto_val" != "1" ]; then
			uci -q set "network.$i.auto=1"
			need_commit=1
		fi
		# proto 校验：none/static 时自动拨号成功也取不到地址，必须让人看得见
		p=$(uci -q get "network.$i.proto")
		case "$p" in
			dhcp|dhcpv6|static|none) ;;
			*) logger -t at-webserver "警告：$i 的 proto=$p 非 dhcp 系，自动拨号后可能取不到地址" ;;
		esac
	done

	if [ "$need_commit" -eq 1 ]; then
		uci -q commit network
		logger -t at-webserver "已将 $iface_4g/$iface_6g 设置为开机自启（auto=1）"
	fi

	if ! uci -q get "network.$iface_4g" >/dev/null 2>&1; then
		logger -t at-webserver "警告：$iface_4g 创建失败（uci 未生效），跳过拉起"
		return 0
	fi

	# 后端拨号达成后会调用 on-uplink 钩子；这里做启动期的兜底重试。
	n=0
	got4=0
	while [ "$n" -lt "$IFUP_RETRY_TIMES" ]; do
		if iface_has_address "$iface_4g"; then
			logger -t at-webserver "$iface_4g 已取到地址（第 $((n + 1)) 次检查，设备 $(iface_device_name "$iface_4g")）"
			got4=1
			break
		fi
		# ifup 是幂等的：接口已 up 但仍在等 DHCP 时重复调用不会破坏状态
		ifup "$iface_4g" 2>&1 | logger -t at-webserver || true
		if uci -q get "network.$iface_6g" >/dev/null 2>&1; then
			ifup "$iface_6g" 2>&1 | logger -t at-webserver || true
		fi
		n=$((n + 1))
		sleep "$IFUP_RETRY_INTERVAL"
	done

	if [ "$got4" -eq 0 ]; then
		logger -t at-webserver "警告：$iface_4g 在 $((IFUP_RETRY_TIMES * IFUP_RETRY_INTERVAL))s 内未取到地址。\
已尝试 $(iface_device_name "$iface_4g")；请检查 logread -e at-webserver 与「模组是否已驻网」；\
hotplug 钩子与后端周期对账会继续处理"
	fi

	# V6 不判定达成：只记录实际结果，便于排障时一眼看出"是有 v6 还是没下发"
	if uci -q get "network.$iface_6g" >/dev/null 2>&1; then
		if iface_has_address "$iface_6g"; then
			logger -t at-webserver "$iface_6g 已获取 IPv6 地址"
		else
			logger -t at-webserver "$iface_6g 暂未获取 IPv6 地址（按实际网络状况获取，不影响 IPv4 使用）"
		fi
	fi
	return 0
}

# ---------------------------------------------------------------------------
# 防火墙规则
#
# 清理列表里有一部分是历史名字（at_webserver_wan_block / at_webserver_wan_allow /
# at_rpc_wan_block 当前版本不再创建），保留它们是为了把旧版本留下的残留一并清掉；
# 实际会创建的只有下面 apply_firewall_rules 里出现的四个。
# ---------------------------------------------------------------------------
FW_RULE_NAMES="at_webserver_wan_block at_webserver_wan_allow at_module_restrict \
at_module_wan_block at_module_wan_allow at_rpc_wan_allow at_rpc_wan_block"

fw_clean_rules() {
	local rule_name rule_idx
	for rule_name in $FW_RULE_NAMES; do
		rule_idx=$(uci show firewall 2>/dev/null | grep "\.name='$rule_name'" | cut -d'[' -f2 | cut -d']' -f1 | head -n1)
		[ -n "$rule_idx" ] && uci delete firewall.@rule[$rule_idx] 2>/dev/null
	done
	uci commit firewall 2>/dev/null
}

apply_firewall_rules() {
	local module_allow_wan restrict_module module_host module_port
	local rpc_allow_wan rpc_port

	config_get_bool module_allow_wan config network_allow_wan 0
	config_get_bool restrict_module config network_restrict_access 0
	config_get module_host config network_host '192.168.8.1'
	config_get module_port config network_port '20249'
	config_get_bool rpc_allow_wan config websocket_allow_wan 0
	config_get rpc_port config websocket_port 8765

	fw_clean_rules

	# RPC 对外监听时放行端口；否则保持无 WAN 规则（仅回环）
	if [ "$rpc_allow_wan" -eq 1 ]; then
		uci add firewall rule >/dev/null
		uci set firewall.@rule[-1].name='at_rpc_wan_allow'
		uci set firewall.@rule[-1].src='lan'
		uci set firewall.@rule[-1].dest='*'
		uci set firewall.@rule[-1].dest_port="$rpc_port"
		uci set firewall.@rule[-1].proto='tcp'
		uci set firewall.@rule[-1].target='ACCEPT'
		uci set firewall.@rule[-1].enabled='1'
		logger -t at-webserver "已允许访问 RPC 端口 $rpc_port（建议设置 auth_key）"
	fi

	if [ "$module_allow_wan" -eq 1 ]; then
		uci add firewall rule >/dev/null
		uci set firewall.@rule[-1].name='at_module_wan_allow'
		uci set firewall.@rule[-1].src='wan'
		uci set firewall.@rule[-1].dest='*'
		uci set firewall.@rule[-1].dest_ip="$module_host"
		uci set firewall.@rule[-1].dest_port="$module_port"
		uci set firewall.@rule[-1].proto='tcp'
		uci set firewall.@rule[-1].target='ACCEPT'
		uci set firewall.@rule[-1].enabled='1'
	else
		uci add firewall rule >/dev/null
		uci set firewall.@rule[-1].name='at_module_wan_block'
		uci set firewall.@rule[-1].src='wan'
		uci set firewall.@rule[-1].dest='*'
		uci set firewall.@rule[-1].dest_ip="$module_host"
		uci set firewall.@rule[-1].dest_port="$module_port"
		uci set firewall.@rule[-1].proto='tcp'
		uci set firewall.@rule[-1].target='REJECT'
		uci set firewall.@rule[-1].enabled='1'
	fi

	if [ "$restrict_module" -eq 1 ]; then
		uci add firewall rule >/dev/null
		uci set firewall.@rule[-1].name='at_module_restrict'
		uci set firewall.@rule[-1].src='lan'
		uci set firewall.@rule[-1].dest='*'
		uci set firewall.@rule[-1].dest_ip="$module_host"
		uci set firewall.@rule[-1].dest_port="$module_port"
		uci set firewall.@rule[-1].proto='tcp'
		uci set firewall.@rule[-1].target='REJECT'
		uci set firewall.@rule[-1].enabled='1'
	fi

	uci commit firewall 2>/dev/null
	# 后台 reload，避免阻塞；失败不致命
	timeout 8 /etc/init.d/firewall reload >/dev/null 2>&1 || true
	logger -t at-webserver "防火墙规则已应用"
}

stop_service() {
	logger -t at-webserver "停止服务..."
	echo "Stopping AT WebServer..."

	killall -q "$PROG_NAME" 2>/dev/null
	rm -f /var/run/at-webserver-rust.pid

	# 清理防火墙规则（幂等，列表与 apply_firewall_rules 一致）
	fw_clean_rules
	timeout 8 /etc/init.d/firewall reload >/dev/null 2>&1 || true
	logger -t at-webserver "已清理所有防火墙规则"

	sleep 1
	logger -t at-webserver "服务已停止"
	echo "AT WebServer stopped"
}

reload_service() {
	logger -t at-webserver "重新加载配置..."
	echo "Reloading AT WebServer configuration..."

	uci -q commit at-webserver

	# 通过 procd 重启实例，避免 killall 与 respawn 竞态导致双实例
	if ubus -q call service list '{"name":"at-webserver"}' >/dev/null 2>&1; then
		ubus call service delete '{"name":"at-webserver"}' >/dev/null 2>&1 || true
		sleep 1
	fi
	# 兜底清理残留（仅一次，不依赖 killall 反复拉起）
	killall -q "$PROG_NAME" 2>/dev/null
	rm -f /var/run/at-webserver-rust.pid
	sleep 1

	start_service

	logger -t at-webserver "配置重新加载完成"
}

# 由后端在「自动拨号达成」时调用（on-uplink 钩子），也可手动执行：
#   /etc/init.d/at-webserver on_uplink
# 只做一件事：把模组接口 ifup 一次。让「拨号成功」与「网卡要地址」这两件事
# 有明确先后关系，而不是靠 init.d 在后端拨号之前抢跑 + 猜时间。
on_uplink() {
	local i
	ensure_iface_created "$IFACE_4G" dhcp || return 1
	ensure_iface_created "$IFACE_6G" dhcpv6 || true
	for i in "$IFACE_4G" "$IFACE_6G"; do
		uci -q get "network.$i" >/dev/null 2>&1 || continue
		if iface_has_address "$i"; then
			continue
		fi
		ifup "$i" 2>&1 | logger -t at-webserver || true
	done
	return 0
}

# 语义化别名：确保模组接口存在（V4 必建、V6 也建）并尝试拉起一次。
# 供安装/升级流程（Makefile 的 postinst、uci-defaults）以及手动排查使用：
#   /etc/init.d/at-webserver ensure_interfaces
# 说明：安装时模组往往还没就绪，这里只做「接口先在」这件事；
# 取址由 init.d 的后台重试、hotplug 钩子与后端拨号就绪通知继续负责。
ensure_interfaces() {
	local i

	# 只保证接口存在（并置 auto=1），**不做 ifup**。
	#
	# 原因：ifup 会等待 DHCP 就绪，单个接口可达数十秒；安装期（postinst）同步调用
	# 会把 apk/opkg 拖住 —— 实测合并前的版本在这里耗时 180s 才返回。
	# 拉起交给 init.d 的后台重试、hotplug 钩子与后端拨号就绪通知。
	ensure_iface_created "$IFACE_4G" dhcp || return 1
	ensure_iface_created "$IFACE_6G" dhcpv6 || true

	for i in "$IFACE_4G" "$IFACE_6G"; do
		uci -q get "network.$i" >/dev/null 2>&1 || continue
		if [ "$(uci -q get "network.$i.auto")" != "1" ]; then
			uci -q set "network.$i.auto=1"
			uci -q commit network
			logger -t at-webserver "$i 已设为 auto=1"
		fi
	done
	return 0
}

service_triggers() {
	procd_add_reload_trigger "at-webserver"
}
