#!/bin/sh
# ============================================================================
# 模组带 Audio Class 时自动装载 ALSA 依赖链
# ----------------------------------------------------------------------------
# 背景：MT5700M-CN 的 USB 没有任何 Audio Class 接口，语音音频在物理上就没
# 引到软件能读到的地方（详见 REFERENCE §声音）。换成带 UAC 的模组后，音频
# 只差内核模块 —— 那些 .ko 已经随插件打包，这里负责在设备出现时装上。
#
# 为什么挂在 usb hotplug 而不是常驻轮询：插拔是事件，等事件比自己轮询准，
# 也不占 CPU。开机时的 coldplug 同样会走一遍 add，冷启动也覆盖到了。
#
# ★ 不做「装过就置标志跳过」：usb-storage 之类的设备也会触发本脚本，但
#   audio-ko.sh 内部先 probe UAC，没有就直接返回 3 —— 判断只有一处。
# ============================================================================

[ "$ACTION" = "add" ] || exit 0

case "$DEVTYPE" in
	usb_device|usb_interface) ;;
	*) exit 0 ;;
esac

(
	# 等接口节点全部建好再探测：UAC 的 Audio Control 接口通常在
	# Configuration 描述符之后才被注册，立即探测可能只看到半个设备。
	sleep 1
	/usr/share/mt5700/audio-ko.sh load
) &
