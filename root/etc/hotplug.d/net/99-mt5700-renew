#!/bin/sh
# ============================================================================
# 模组网口重新注册时立即续约
# ----------------------------------------------------------------------------
# 背景（2026-09-13 实测的断网根因）：
#   MT5700 模组 USB 重新枚举后，cdc_ncm 会重新注册 eth2（MAC 不变）。
#   netifd 只看到「link up」，认为接口正常，不会重跑 DHCP
#   —— 接口配了 force_link=1，而且 DHCP 租约长达 6 天（518400s）。
#   可重枚举后模组改为直接下发运营商地址，路由器仍持有旧地址，
#   导致默认网关在链路上根本不存在 → ARP 永远 INCOMPLETE → 静默断网。
#
# 本脚本在网口重新注册时主动续一次租约，把断网窗口从「直到被人工发现」
# 缩短到几秒。它是**事件驱动**的，只在真的发生重枚举时才动一次，
# 不做常驻轮询（常驻看门狗已于 2026-09-20 整体移除）。
# ============================================================================

[ "$ACTION" = "add" ] || exit 0
# 设备名从 UCI 取（与 init.d ensure_modem_interface 同源）：定制机型的设备名
# 不叫 eth2 时，硬过滤会让本脚本永不触发 —— 续约静默失效（2026-10-22 审计）。
dev=$(uci -q get network.MT5700M.device 2>/dev/null)
[ -n "$dev" ] || dev=$(uci -q get network.MT5700M.ifname 2>/dev/null)
[ -n "$dev" ] || dev='eth2'
dev=${dev%% *}
[ "$INTERFACE" = "$dev" ] || exit 0

# 防抖：60 秒内只处理一次，避免模组枚举抖动导致反复续约
# ★ 原子抢占（2026-10-22 审计）：原先「读 stamp → 判断 → 写 stamp」三步非原子，
#   两个几乎同时到达的 add 都读到旧值、都通过检查 → 两路续约重叠。
#   mkdir 天然原子：抢不到锁的直接退出 —— 对方就是刚被触发的那个实例，让它干。
#   锁内时间戳超 120s 视为异常退出残留，清掉自愈，避免永久卡死。
STAMP=/var/run/mt5700-renew.stamp
LOCK="$STAMP.lock"
now=$(date +%s)
if ! mkdir "$LOCK" 2>/dev/null; then
	lock_ts=$(cat "$LOCK/ts" 2>/dev/null)
	case "$lock_ts" in ''|*[!0-9]*) lock_ts=0;; esac
	if [ $((now - lock_ts)) -lt 120 ]; then
		exit 0
	fi
	rm -rf "$LOCK"
	mkdir "$LOCK" 2>/dev/null || exit 0
fi
echo "$now" > "$LOCK/ts" 2>/dev/null
last=$(cat "$STAMP" 2>/dev/null)
case "$last" in ''|*[!0-9]*) last=0;; esac
if [ $((now - last)) -lt 60 ]; then
	rmdir "$LOCK" 2>/dev/null
	exit 0
fi
echo "$now" > "$STAMP"

(
	# 等模组把数据面准备好（USB 枚举完成后网口还需要一点时间）
	sleep 6
	iface=MT5700M
	if ubus -S call network.interface."$iface" renew >/dev/null 2>&1; then
		logger -t mt5700-hotplug "eth2 重新注册，已触发 $iface 续约"
	else
		ifdown "$iface" >/dev/null 2>&1
		sleep 2
		ifup "$iface" >/dev/null 2>&1
		logger -t mt5700-hotplug "eth2 重新注册，renew 不可用，已重启 $iface"
	fi
) &
# 防抖完成，放锁（后台任务已提交，不再受本锁保护）
rmdir "$LOCK" 2>/dev/null
